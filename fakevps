#!/usr/bin/env bash
# FakeVPS — start/stop a local Ubuntu node that feels like a paid VPS.
# Copyright (c) 2026 Mr-Aurevo-X
set -euo pipefail

FAKEVPS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$FAKEVPS_ROOT/lib/common.sh"
# shellcheck source=lib/ssh.sh
source "$FAKEVPS_ROOT/lib/ssh.sh"
for _lib in qemu fast provision ui-server metrics; do
  if [[ -f "$FAKEVPS_ROOT/lib/${_lib}.sh" ]]; then
    # shellcheck disable=SC1090
    source "$FAKEVPS_ROOT/lib/${_lib}.sh"
  fi
done

usage() {
  cat <<'EOF'
FakeVPS — rehearse a paid VPS locally
Copyright (c) 2026 Mr-Aurevo-X
Based on FakeVPS — https://github.com/Mr-Aurevo-X/FakeVPS

  ./fakevps up [--fast]     Start the node + cockpit
  ./fakevps down [--wipe]   Stop node + cockpit (--wipe erases all stored state)
  ./fakevps status [--json]
  ./fakevps metrics         Envelope telemetry JSON (guest only)
  ./fakevps logs
  ./fakevps ssh [--] [cmd]
  ./fakevps ui              Open http://127.0.0.1:8787
  ./fakevps panel           Open bot panel if BOT_PANEL_PORT is set
  ./fakevps attach <dir>    Point BOT_DIR at any Discord bot and deploy
  ./fakevps sync            Re-rsync BOT_DIR
  ./fakevps restart-bot     Restart guest bot (systemd or compose)
  ./fakevps reset           Wipe disk/container and reprovision next up
  ./fakevps snapshot [list|save <name>|restore <name>|rm <name>]  (kvm, node stopped)
  ./fakevps doctor          Check the host before the first up
  ./fakevps audit           Check secrets/state hygiene on this tree
  ./fakevps install-service [--fast|--kvm]  systemd --user unit
  ./fakevps --version

  ./fakevps -p <name> <command>   Use profile profiles/<name>.env
                                  (own state, ports, bot — see profiles/)

Windows: use WSL2, then ./fakevps up --fast
EOF
}

cmd_version() {
  printf 'FakeVPS %s\n' "$FAKEVPS_VERSION"
  printf 'Copyright (c) 2026 Mr-Aurevo-X\n'
  printf 'Based on FakeVPS — https://github.com/Mr-Aurevo-X/FakeVPS\n'
}

print_urls() {
  printf '\n  Cockpit  http://127.0.0.1:%s\n' "$UI_PORT"
  printf '  SSH      ssh -p %s %s@127.0.0.1\n' "$SSH_PORT" "$SSH_USER"
  if [[ -n "${BOT_PANEL_PORT}" ]]; then
    printf '  Panel    http://127.0.0.1:%s\n' "$BOT_PANEL_PORT"
  fi
  printf '\n'
}

cmd_up() {
  local mode
  mode="$(active_backend)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fast) mode=fast; shift ;;
      --kvm) mode=kvm; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  ensure_dirs
  ensure_ssh_key
  if [[ -z "${FAKEVPS_SKIP_UI:-}" ]]; then
    ui_start || log "cockpit not listening yet — node start continues"
  fi
  if guest_is_up; then
    if [[ "$mode" == "fast" ]] && ! fast_docker_graph_mounted; then
      log "fast node lacks a host Docker graph — recreating so image pulls work"
    else
      log "already online — not starting a second node"
      print_urls
      return 0
    fi
  fi
  if [[ "$mode" == "fast" ]]; then
    fast_up
  else
    qemu_up
  fi
  if ! wait_ssh; then
    print_urls
    return 1
  fi
  first_boot_provision || log "provision reported errors — cockpit still available"
  if [[ -z "${FAKEVPS_SKIP_UI:-}" ]]; then
    open_url "$(ui_url)"
  fi
  print_urls
}

# Erase everything the node stored: guest disk (bot code + injected .env),
# fast Docker graph, logs, caches. secrets/ and the host SSH key are kept.
wipe_state() {
  qemu_reset_disk
  fast_reset
  rm -f "$(marker_path)" "$STATE_DIR/backend" "$KNOWN_HOSTS"
  rm -f "$STATE_DIR"/metrics.* "$STATE_DIR"/.env.inject.* 2>/dev/null || true
  rm -f "$STATE_DIR/kvm/serial.log" 2>/dev/null || true
  rm -rf "$STATE_DIR/logs"
  mkdir -p "$STATE_DIR/logs"
  log "wipe complete — the node kept nothing (next up re-provisions)"
}

cmd_down() {
  ensure_dirs
  local wipe=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wipe) wipe=true; shift ;;
      *) die "usage: ./fakevps down [--wipe]" ;;
    esac
  done
  if is_ephemeral; then
    wipe=true
  fi
  local be
  be="$(active_backend)"
  log "stopping ($be)"
  case "$be" in
    fast) fast_down ;;
    kvm) qemu_acpi_down ;;
    *)
      fast_down || true
      qemu_acpi_down || true
      ;;
  esac
  ui_stop
  if [[ "$wipe" == true ]]; then
    wipe_state
  fi
}

guest_is_up() {
  guest_ssh true >/dev/null 2>&1
}

status_json() {
  local be running=false ssh_ok=false docker_ok=false bot_ok=false ui_ok=false
  local probe="{}" runtime="none" bot_dir_display=""
  be="$(active_backend 2>/dev/null || echo "$BACKEND")"
  if [[ "$be" == "fast" ]] && fast_running; then running=true; fi
  if [[ "$be" == "kvm" ]] && qemu_running; then running=true; fi
  if [[ "$running" == false ]]; then
    if qemu_running; then be=kvm; running=true; fi
    if fast_running; then be=fast; running=true; fi
  fi
  if guest_is_up; then ssh_ok=true; fi
  if ui_running; then ui_ok=true; fi
  bot_dir_display="$(display_bot_dir "${BOT_DIR:-}")"
  if [[ -n "${BOT_DIR}" && -d "${BOT_DIR}" ]]; then
    runtime="$("$FAKEVPS_ROOT/provision/detect-runtime.sh" "$BOT_DIR" "${BOT_RUNTIME:-auto}" 2>/dev/null || echo none)"
  fi
  if [[ "$ssh_ok" == true ]]; then
    probe="$(guest_status_probe 2>/dev/null || echo '{}')"
    [[ "$probe" == \{* ]] || probe="{}"
  fi
  local uptime="" metrics="{}"
  if [[ "$running" == true || "$ssh_ok" == true ]]; then
    uptime="$(node_uptime_sec 2>/dev/null || true)"
    metrics="$(collect_metrics_json 2>/dev/null || true)"
    [[ "$metrics" == \{* ]] || metrics="{}"
  fi
  local bot_attached=false
  if [[ -n "${BOT_DIR}" && -d "${BOT_DIR}" ]]; then
    bot_attached=true
  fi
  local ephemeral=false
  if is_ephemeral; then
    ephemeral=true
  fi
  FAKEVPS_METRICS="$metrics" FAKEVPS_PROBE="$probe" FAKEVPS_RUNTIME="$runtime" \
    FAKEVPS_BOT_DIR_DISPLAY="$bot_dir_display" \
    python3 - "$be" "$running" "$ssh_ok" "$docker_ok" "$bot_ok" "$ui_ok" "$uptime" \
    "$RAM_MB" "$CPUS" "$DISK_GB" "$SSH_PORT" "$UI_PORT" "${BOT_PANEL_PORT:-}" \
    "$bot_attached" "$ephemeral" <<'PY'
import json, os, sys
keys = [
    "backend", "running", "ssh", "docker", "bot", "ui", "uptime_sec",
    "ram_mb", "cpus", "disk_gb", "ssh_port", "ui_port", "panel_port",
    "bot_attached", "ephemeral",
]
vals = sys.argv[1:]
data = dict(zip(keys, vals))
for k in ("running", "ssh", "docker", "bot", "ui", "bot_attached", "ephemeral"):
    data[k] = data[k] == "true"
for k in ("ram_mb", "cpus", "disk_gb", "ssh_port", "ui_port"):
    data[k] = int(data[k] or 0)
data["uptime_sec"] = int(data["uptime_sec"] or 0)
try:
    extra = json.loads(os.environ.get("FAKEVPS_METRICS") or "{}")
except json.JSONDecodeError:
    extra = {}
if isinstance(extra, dict):
    data.update(extra)
try:
    probe = json.loads(os.environ.get("FAKEVPS_PROBE") or "{}")
except json.JSONDecodeError:
    probe = {}
if isinstance(probe, dict) and probe:
    data["docker"] = bool(probe.get("docker"))
    data["bot"] = bool(probe.get("bot"))
    services = probe.get("services")
    data["services"] = services if isinstance(services, list) else []
    data["token_present"] = bool(probe.get("token_present"))
    guest_rt = str(probe.get("runtime") or "").strip()
else:
    data["services"] = []
    data["token_present"] = False
    guest_rt = ""
host_rt = (os.environ.get("FAKEVPS_RUNTIME") or "none").strip() or "none"
data["runtime"] = host_rt if host_rt != "none" else (guest_rt or "none")
data["bot_dir_display"] = os.environ.get("FAKEVPS_BOT_DIR_DISPLAY") or ""
data.pop("bot_dir", None)
print(json.dumps(data))
PY
}

cmd_status() {
  if [[ "${1:-}" == "--json" ]]; then
    status_json
    return
  fi
  local be
  be="$(active_backend)"
  printf 'backend   %s\n' "$be"
  printf 'kvm       %s\n' "$(qemu_running && echo up || echo down)"
  printf 'fast      %s\n' "$(fast_running && echo up || echo down)"
  printf 'ssh       %s\n' "$(guest_is_up && echo up || echo down)"
  printf 'cockpit   http://127.0.0.1:%s (%s)\n' "$UI_PORT" "$(ui_running && echo up || echo down)"
  if [[ -n "${BOT_PANEL_PORT}" ]]; then
    printf 'panel     http://127.0.0.1:%s\n' "$BOT_PANEL_PORT"
  else
    printf 'panel     (not configured)\n'
  fi
}

cmd_logs() {
  if [[ -f "$LOG_FILE" ]]; then
    tail -n 40 "$LOG_FILE"
  fi
  if [[ -f "$STATE_DIR/kvm/serial.log" ]]; then
    echo "--- serial ---"
    tail -n 20 "$STATE_DIR/kvm/serial.log"
  fi
  if command -v docker >/dev/null 2>&1 && fast_running; then
    echo "--- docker ---"
    docker logs --tail 20 fakevps 2>/dev/null || true
  fi
}

cmd_ssh() {
  if [[ "${1:-}" == "--" ]]; then
    shift
  fi
  guest_ssh "$@"
}

cmd_ui() {
  ui_start
  printf 'http://127.0.0.1:%s\n' "$UI_PORT"
  open_url "$(ui_url)"
}

cmd_panel() {
  if [[ -z "${BOT_PANEL_PORT}" ]]; then
    printf 'No BOT_PANEL_PORT set — this bot has no forwarded web UI.\n' >&2
    return 1
  fi
  local url="http://127.0.0.1:${BOT_PANEL_PORT}"
  printf '%s\n' "$url"
  open_url "$url"
}

cmd_attach() {
  local dir="${1:-}"
  [[ -n "$dir" ]] || die "usage: ./fakevps attach /path/to/bot"
  dir="$(cd "$dir" && pwd)"
  write_config_key BOT_DIR "$dir"
  BOT_DIR="$dir"
  log "BOT_DIR=$(display_bot_dir "$dir")"
  if guest_is_up; then
    push_provision_scripts
    provision_bot || die "bot deploy failed — fix the errors above, then ./fakevps attach again"
  else
    log "node is down — bot will deploy on next ./fakevps up"
  fi
  printf '  Cockpit  http://127.0.0.1:%s\n' "$UI_PORT"
}

cmd_sync() {
  [[ -n "${BOT_DIR}" ]] || die "BOT_DIR is empty — ./fakevps attach <dir> first"
  guest_is_up || die "node is down"
  sync_bot_tree "$BOT_DIR"
}

cmd_metrics() {
  collect_metrics_json
}

cmd_restart_bot() {
  guest_is_up || die "node is down"
  log "restart bot"
  guest_ssh bash -s <<'EOF'
set -euo pipefail
APP=/home/ubuntu/app
if systemctl is-active --quiet discord-bot.service \
  || systemctl is-enabled --quiet discord-bot.service 2>/dev/null; then
  sudo systemctl restart discord-bot.service
  echo "restarted discord-bot.service"
  exit 0
fi
cd "$APP"
for f in docker-compose.prod.yml docker-compose.yml compose.yaml docker-compose.yaml; do
  if [[ -f "$f" ]]; then
    docker compose -f "$f" restart
    echo "restarted compose $f"
    exit 0
  fi
done
if docker ps -aq --filter name=fakevps-bot | grep -q .; then
  docker restart fakevps-bot
  echo "restarted fakevps-bot"
  exit 0
fi
echo "no bot service to restart" >&2
exit 1
EOF
}

cmd_reset() {
  cmd_down || true
  wipe_state
  log "reset complete — next up is a fresh node"
}

cmd_snapshot() {
  local be action name disk
  be="$(active_backend)"
  action="${1:-list}"
  shift || true
  name="${1:-}"
  if [[ "$be" != "kvm" ]]; then
    die "snapshots need the kvm backend — the fast node is disposable, re-run ./fakevps attach instead"
  fi
  require_cmd qemu-img
  disk="$(qemu_disk_path)"
  [[ -f "$disk" ]] || die "no node disk yet — run ./fakevps up first"
  case "$action" in
    list)
      qemu-img snapshot -l "$disk"
      ;;
    save|restore|rm)
      [[ -n "$name" ]] || die "usage: ./fakevps snapshot $action <name>"
      if guest_is_up; then
        die "stop the node first: ./fakevps down"
      fi
      case "$action" in
        save)
          qemu-img snapshot -c "$name" "$disk"
          log "snapshot '$name' saved"
          ;;
        restore)
          qemu-img snapshot -a "$name" "$disk"
          log "snapshot '$name' restored — ./fakevps up boots it"
          ;;
        rm)
          qemu-img snapshot -d "$name" "$disk"
          log "snapshot '$name' deleted"
          ;;
      esac
      ;;
    *)
      die "usage: ./fakevps snapshot [list|save <name>|restore <name>|rm <name>]"
      ;;
  esac
}

doctor_line() {
  printf '  %-5s %s\n' "$1" "$2"
}

cmd_doctor() {
  local be fails=0 warns=0 c
  be="$(active_backend)"
  printf 'FakeVPS doctor — backend: %s\n\n' "$be"

  for c in python3 ssh rsync scp; do
    if command -v "$c" >/dev/null 2>&1; then
      doctor_line OK "$c present"
    else
      doctor_line FAIL "$c missing — install it"
      fails=$((fails + 1))
    fi
  done

  if [[ -e /dev/kvm ]]; then
    if [[ -r /dev/kvm && -w /dev/kvm ]]; then
      doctor_line OK "/dev/kvm accessible"
    else
      doctor_line WARN "/dev/kvm exists but not writable — add yourself to the kvm group"
      warns=$((warns + 1))
    fi
  elif [[ "$be" == "kvm" ]]; then
    doctor_line FAIL "/dev/kvm missing — no KVM here; use ./fakevps up --fast"
    fails=$((fails + 1))
  else
    doctor_line WARN "/dev/kvm missing (fast backend unaffected)"
    warns=$((warns + 1))
  fi
  if command -v qemu-system-x86_64 >/dev/null 2>&1; then
    doctor_line OK "qemu-system-x86_64 present"
  elif [[ "$be" == "kvm" ]]; then
    doctor_line FAIL "qemu-system-x86_64 missing — install qemu, or use --fast"
    fails=$((fails + 1))
  else
    doctor_line WARN "qemu-system-x86_64 missing (fast backend unaffected)"
    warns=$((warns + 1))
  fi

  if command -v docker >/dev/null 2>&1; then
    if docker info >/dev/null 2>&1; then
      doctor_line OK "docker daemon reachable"
    elif [[ "$be" == "fast" ]]; then
      doctor_line FAIL "docker installed but the daemon is unreachable (permissions? service down?)"
      fails=$((fails + 1))
    else
      doctor_line WARN "docker daemon unreachable (only matters for --fast)"
      warns=$((warns + 1))
    fi
  elif [[ "$be" == "fast" ]]; then
    doctor_line FAIL "docker missing — required for --fast"
    fails=$((fails + 1))
  else
    doctor_line WARN "docker missing (only matters for --fast)"
    warns=$((warns + 1))
  fi

  local avail_mb
  avail_mb="$(awk '/MemAvailable/ {print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 0)"
  if (( avail_mb >= RAM_MB )); then
    doctor_line OK "RAM available ${avail_mb} MB (node wants ${RAM_MB} MB)"
  else
    doctor_line WARN "RAM available ${avail_mb} MB < RAM_MB=${RAM_MB} — the node may swap or OOM"
    warns=$((warns + 1))
  fi

  local avail_gb
  avail_gb="$(df -BG --output=avail "$FAKEVPS_ROOT" 2>/dev/null | tail -1 | tr -dc '0-9')"
  if [[ -n "$avail_gb" ]] && (( avail_gb >= DISK_GB )); then
    doctor_line OK "disk free ${avail_gb} GB (node wants ${DISK_GB} GB)"
  else
    doctor_line WARN "disk free ${avail_gb:-?} GB < DISK_GB=${DISK_GB}"
    warns=$((warns + 1))
  fi

  local port
  for port in "$SSH_PORT" "$UI_PORT"; do
    if host_bind_ok "$port"; then
      if guest_is_up || ui_running; then
        doctor_line OK "port ${port} in use by this node"
      else
        doctor_line WARN "port ${port} already in use by something else"
        warns=$((warns + 1))
      fi
    else
      doctor_line OK "port ${port} free"
    fi
  done

  if grep -qi microsoft /proc/version 2>/dev/null; then
    doctor_line INFO "WSL detected — recommended: ./fakevps up --fast (and RAM in %UserProfile%\\.wslconfig)"
  fi

  printf '\n%d fail, %d warn\n' "$fails" "$warns"
  (( fails == 0 )) || exit 1
}

cmd_audit() {
  local fails=0 perm f
  printf 'FakeVPS audit — %s\n\n' "$(display_bot_dir "$FAKEVPS_ROOT")"

  if [[ -d "$SECRETS_DIR" ]]; then
    perm="$(stat -c '%a' "$SECRETS_DIR" 2>/dev/null || echo '?')"
    if [[ "$perm" == "700" ]]; then
      doctor_line OK "secrets/ is 700"
    else
      doctor_line WARN "secrets/ is $perm — fix: chmod 700 secrets"
    fi
    for f in "$SECRETS_DIR"/*.env "$SSH_KEY"; do
      [[ -f "$f" ]] || continue
      perm="$(stat -c '%a' "$f" 2>/dev/null || echo '?')"
      if [[ "$perm" == "600" ]]; then
        doctor_line OK "$(basename "$f") is 600"
      else
        doctor_line FAIL "$(basename "$f") is $perm — fix: chmod 600 secrets/$(basename "$f")"
        fails=$((fails + 1))
      fi
    done
  fi

  if command -v git >/dev/null 2>&1 && [[ -d "$FAKEVPS_ROOT/.git" ]]; then
    for f in config.env secrets/discord.env; do
      if git -C "$FAKEVPS_ROOT" ls-files --error-unmatch "$f" >/dev/null 2>&1; then
        doctor_line FAIL "$f is tracked by git — remove it: git rm --cached $f"
        fails=$((fails + 1))
      else
        doctor_line OK "$f not tracked by git"
      fi
    done
    if git -C "$FAKEVPS_ROOT" ls-files -- 'state/*' 2>/dev/null | grep -q .; then
      doctor_line FAIL "state/ has tracked files — it must stay untracked"
      fails=$((fails + 1))
    else
      doctor_line OK "state/ not tracked by git"
    fi
  fi

  if compgen -G "$STATE_DIR/.env.inject.*" >/dev/null; then
    doctor_line FAIL "leftover injected env in state/ — fix: rm state/.env.inject.*"
    fails=$((fails + 1))
  else
    doctor_line OK "no leftover injected env in state/"
  fi

  printf '\n%d fail\n' "$fails"
  (( fails == 0 )) || exit 1
}

cmd_install_service() {
  local mode up_args unit_dir
  mode="$(active_backend)"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fast) mode=fast; shift ;;
      --kvm) mode=kvm; shift ;;
      *) die "usage: ./fakevps install-service [--fast|--kvm]" ;;
    esac
  done
  up_args="up"
  if [[ "$mode" == "fast" ]]; then
    up_args="up --fast"
  fi
  unit_dir="$HOME/.config/systemd/user"
  mkdir -p "$unit_dir"
  sed -e "s|@FAKEVPS_ROOT@|${FAKEVPS_ROOT}|g" \
      -e "s|@FAKEVPS_UP_ARGS@|${up_args}|g" \
    "$FAKEVPS_ROOT/contrib/fakevps.service" >"$unit_dir/fakevps.service"
  systemctl --user daemon-reload
  printf 'Installed (%s). Enable with:\n  systemctl --user enable --now fakevps\n' "$mode"
}

main() {
  while [[ "${1:-}" == "-p" || "${1:-}" == "--profile" ]]; do
    shift
    [[ -n "${1:-}" ]] || die "usage: ./fakevps -p <name> <command>"
    export FAKEVPS_PROFILE="$1"
    shift
  done
  load_config
  ensure_dirs
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    status) cmd_status "$@" ;;
    logs) cmd_logs "$@" ;;
    ssh) cmd_ssh "$@" ;;
    ui) cmd_ui "$@" ;;
    panel) cmd_panel "$@" ;;
    attach) cmd_attach "$@" ;;
    sync) cmd_sync "$@" ;;
    restart-bot) cmd_restart_bot "$@" ;;
    metrics) cmd_metrics "$@" ;;
    reset) cmd_reset "$@" ;;
    snapshot) cmd_snapshot "$@" ;;
    doctor) cmd_doctor "$@" ;;
    audit) cmd_audit "$@" ;;
    install-service) cmd_install_service "$@" ;;
    -V|--version|version) cmd_version ;;
    -h|--help|help|"") usage ;;
    *) die "unknown command: $cmd" ;;
  esac
  reclaim_runtime_dirs
}

main "$@"
