# Copy to config.env (never commit config.env).

# Path to any Discord bot on the host. Empty = fresh VPS, Docker only.
BOT_DIR=

# auto | compose | docker | node | python | none
BOT_RUNTIME=auto

# Optional web UI inside the guest (forwarded to 127.0.0.1). Empty = no panel bind.
BOT_PANEL_PORT=

# kvm (isolation) or fast (privileged Docker; this is the default).
# ./fakevps install-service follows this or state/backend unless you pass --fast/--kvm.
BACKEND=fast

# true = every `down` erases everything the node stored (guest disk with the
# bot code and injected .env, fast Docker graph, logs, caches). secrets/ and
# the host SSH key are kept. One-shot equivalent: ./fakevps down --wipe.
# Next `up` re-provisions from scratch (slower) and the bot must be re-attached.
EPHEMERAL=false

# false = `up` boots a bare node and never starts the bot by itself, even when
# BOT_DIR is set. You launch it explicitly with ./fakevps attach <dir>.
AUTO_DEPLOY=true

SSH_PORT=2222
UI_PORT=8787
SSH_USER=ubuntu

RAM_MB=6144
CPUS=4
DISK_GB=40
