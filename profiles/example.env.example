# FakeVPS profile — copy to profiles/<name>.env, then: ./fakevps -p <name> up
# A profile overlays config.env and gets its own state/profiles/<name>/
# (disk, logs, cockpit token). Give every profile its OWN ports so two
# nodes can run side by side.

SSH_PORT=2322
UI_PORT=8887
# BOT_PANEL_PORT=3100

# Optional overrides — same keys as config.env:
# RAM_MB=4096
# CPUS=2
# DISK_GB=20
# BACKEND=fast
# EPHEMERAL=true
# BOT_DIR=~/my-other-bot
